 mul.rn.f64 %f2, %f2, %f0; cvt.rn.f64.u32 %f3, %r9;
 add.rn.f64 %f2, %f3, %f2; div.rn.f64 %f2, %f2, %f1;
 abs.f64 %f3, %f2; mul.rn.f64 %f3, %f3, 0d3D00000000000000;
 add.rn.f64 %f2, %f2, %f3; max.f64 %f2, %f2, 0d0000000000000000;
 min.f64 %f2, %f2, 0d406FE00000000000; cvt.rzi.u32.f64 %r22, %f2;
 shr.u32 %r28, %r25, 24; and.b32 %r28, %r28, 255;
 shr.u32 %r35, %r27, 24; and.b32 %r35, %r35, 255;
 add.u32 %r28, %r28, %r35; cvt.rn.f64.u32 %f2, %r28;
 mul.rn.f64 %f2, %f2, %f0; cvt.rn.f64.u32 %f3, %r10;
 add.rn.f64 %f2, %f3, %f2; div.rn.f64 %f2, %f2, %f1;
 abs.f64 %f3, %f2; mul.rn.f64 %f3, %f3, 0d3D00000000000000;
 add.rn.f64 %f2, %f2, %f3; max.f64 %f2, %f2, 0d0000000000000000;
 min.f64 %f2, %f2, 0d406FE00000000000; cvt.rzi.u32.f64 %r23, %f2;
 shl.b32 %r21, %r21, 8; shl.b32 %r22, %r22, 16; shl.b32 %r23, %r23, 24;
 or.b32 %r20, %r20, %r21; or.b32 %r20, %r20, %r22; or.b32 %r20, %r20, %r23;
 mad.lo.u32 %r13, %r19, %r0, %r6; mul.wide.u32 %d2, %r13, 4;
 add.u64 %d3, %d1, %d2; st.global.u32 [%d3], %r20;
 add.s32 %r24, %r24, 1; mov.u32 %r25, 0;
 setp.ge.s32 %p2, %r24, 0; @!%p2 bra REMOVE_DONE;
 setp.lt.s32 %p2, %r24, %r1; @!%p2 bra REMOVE_DONE;
 mad.lo.u32 %r13, %r24, %r0, %r6; mul.wide.u32 %d2, %r13, 4;
 add.u64 %d3, %d0, %d2; ld.global.u32 %r25, [%d3];
REMOVE_DONE:
 shr.u32 %r28, %r25, 0; and.b32 %r28, %r28, 255; sub.u32 %r7, %r7, %r28; add.u32 %r7, %r7, %r32;
 shr.u32 %r28, %r25, 8; and.b32 %r28, %r28, 255; sub.u32 %r8, %r8, %r28; add.u32 %r8, %r8, %r33;
 shr.u32 %r28, %r25, 16; and.b32 %r28, %r28, 255; sub.u32 %r9, %r9, %r28; add.u32 %r9, %r9, %r34;
 shr.u32 %r28, %r25, 24; and.b32 %r28, %r28, 255; sub.u32 %r10, %r10, %r28; add.u32 %r10, %r10, %r35;
 add.u32 %r19, %r19, 1; setp.lt.u32 %p4, %r19, %r1; @%p4 bra ROW;
