 mov.u32 %r3, %ctaid.x; mov.u32 %r4, %ntid.x; mov.u32 %r5, %tid.x;
 mad.lo.u32 %r6, %r3, %r4, %r5;
 setp.ge.u32 %p0, %r6, %r0; @%p0 bra DONE;
 mov.u32 %r7, 0; mov.u32 %r8, 0; mov.u32 %r9, 0; mov.u32 %r10, 0;
 mov.u32 %r11, 0; min.u32 %r12, %r2, %r1;
INIT:
 setp.ge.u32 %p1, %r11, %r12; @%p1 bra INIT_DONE;
 mad.lo.u32 %r13, %r11, %r0, %r6; mul.wide.u32 %d2, %r13, 4;
 add.u64 %d3, %d0, %d2; ld.global.u32 %r14, [%d3];
 shr.u32 %r15, %r14, 0; and.b32 %r15, %r15, 255; add.u32 %r7, %r7, %r15;
 shr.u32 %r16, %r14, 8; and.b32 %r16, %r16, 255; add.u32 %r8, %r8, %r16;
 shr.u32 %r17, %r14, 16; and.b32 %r17, %r17, 255; add.u32 %r9, %r9, %r17;
 shr.u32 %r18, %r14, 24; and.b32 %r18, %r18, 255; add.u32 %r10, %r10, %r18;
 add.u32 %r11, %r11, 1; bra INIT;
INIT_DONE:
 mov.u32 %r19, 0;
ROW:
 sub.s32 %r24, %r19, %r2;
 mov.u32 %r25, 0;
 setp.ge.s32 %p2, %r24, 0;
 @!%p2 bra LEFT_DONE;
 mad.lo.u32 %r13, %r24, %r0, %r6; mul.wide.u32 %d2, %r13, 4;
 add.u64 %d3, %d0, %d2; ld.global.u32 %r25, [%d3];
LEFT_DONE:
 add.u32 %r26, %r19, %r2; mov.u32 %r27, 0;
 setp.lt.u32 %p3, %r26, %r1; @!%p3 bra RIGHT_DONE;
 mad.lo.u32 %r13, %r26, %r0, %r6; mul.wide.u32 %d2, %r13, 4;
 add.u64 %d3, %d0, %d2; ld.global.u32 %r27, [%d3];
RIGHT_DONE:
 shr.u32 %r28, %r25, 0; and.b32 %r28, %r28, 255;
 shr.u32 %r32, %r27, 0; and.b32 %r32, %r32, 255;
 add.u32 %r28, %r28, %r32; cvt.rn.f64.u32 %f2, %r28;
 mul.rn.f64 %f2, %f2, %f0; cvt.rn.f64.u32 %f3, %r7;
 add.rn.f64 %f2, %f3, %f2; div.rn.f64 %f2, %f2, %f1;
 abs.f64 %f3, %f2; mul.rn.f64 %f3, %f3, 0d3D00000000000000;
 add.rn.f64 %f2, %f2, %f3; max.f64 %f2, %f2, 0d0000000000000000;
 min.f64 %f2, %f2, 0d406FE00000000000; cvt.rzi.u32.f64 %r20, %f2;
 shr.u32 %r28, %r25, 8; and.b32 %r28, %r28, 255;
 shr.u32 %r33, %r27, 8; and.b32 %r33, %r33, 255;
 add.u32 %r28, %r28, %r33; cvt.rn.f64.u32 %f2, %r28;
 mul.rn.f64 %f2, %f2, %f0; cvt.rn.f64.u32 %f3, %r8;
 add.rn.f64 %f2, %f3, %f2; div.rn.f64 %f2, %f2, %f1;
 abs.f64 %f3, %f2; mul.rn.f64 %f3, %f3, 0d3D00000000000000;
 add.rn.f64 %f2, %f2, %f3; max.f64 %f2, %f2, 0d0000000000000000;
 min.f64 %f2, %f2, 0d406FE00000000000; cvt.rzi.u32.f64 %r21, %f2;
 shr.u32 %r28, %r25, 16; and.b32 %r28, %r28, 255;
 shr.u32 %r34, %r27, 16; and.b32 %r34, %r34, 255;
