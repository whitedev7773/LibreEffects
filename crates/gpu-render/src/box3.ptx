// Exact fractional box3: f64 arithmetic, transparent borders, byte truncation.
.version 6.0
.target sm_50
.address_size 64
.visible .entry fractional_column(
 .param .u64 src, .param .u64 dst,
 .param .u32 width, .param .u32 height, .param .u32 radius,
 .param .f64 weight, .param .f64 divisor
) {
 .reg .pred %p<8>;
 .reg .b32 %r<48>;
 .reg .b64 %d<8>;
 .reg .f64 %f<8>;
 ld.param.u64 %d0, [src]; ld.param.u64 %d1, [dst];
 ld.param.u32 %r0, [width]; ld.param.u32 %r1, [height];
 ld.param.u32 %r2, [radius];
